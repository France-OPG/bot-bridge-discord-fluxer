# ============================================================
#  discord-fluxer-bridge — Variables d'environnement
#  Copiez ce fichier vers `.env` puis remplissez les valeurs.
#  Ne committez JAMAIS le fichier `.env`.
# ============================================================

# --- Discord ---
# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=

# --- Fluxer ---
# URL de base de l'API Fluxer (instance hébergée ou self-hosted).
# Exemples : "https://api.fluxer.app/v1" ou "https://chat.example.com/v1"
FLUXER_API_URL=

# Token du bot Fluxer (format : <application_id>.<secret>)
FLUXER_TOKEN=

# --- Options du bridge (surchargent config/config.yaml) ---
LOG_LEVEL=info
# Port du serveur d'état HTTP (127.0.0.1 par défaut)
STATUS_PORT=8083