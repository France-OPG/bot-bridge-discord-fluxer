{
  "name": "discord-fluxer-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Passerelle bidirectionnelle temps réel entre Discord et Fluxer (texte, fichiers et voix)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@fluxerjs/core": "3.0.0",
    "@livekit/rtc-node": "0.13.24",
    "discord.js": "14.27.0",
    "pino": "^9.5.0",
    "prism-media": "1.3.5",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.0"
}