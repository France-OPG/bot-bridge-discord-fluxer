[Unit]
# Modèle de service — install.sh remplace les placeholders __APP_DIR__ et
# __APP_USER__ lors de l'installation (voir install.sh).
Description=discord-fluxer-bridge — passerelle bidirectionnelle Discord <-> Fluxer
Documentation=https://github.com/France-OPG/bot-bridge-discord-fluxer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0027

# Durcissement du service
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=__APP_DIR__/data __APP_DIR__/config

[Install]
WantedBy=multi-user.target